# Copy this file to .env. Never commit the real .env file.
# Supabase requires a JDBC URL. Prefer its session pooler when the Docker host
# cannot reach the direct IPv6 database address.
# Example direct connection:
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Example session pooler (use the exact host/username from Supabase Connect):
# DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
DB_USERNAME=your-supabase-database-username
DB_PASSWORD=your-supabase-database-password
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000

# Use a long random value (at least 32 bytes).
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated when more than one frontend is allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://habit-tracker-fe-mocha.vercel.app

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Docker settings
HOST_PORT=8081
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
